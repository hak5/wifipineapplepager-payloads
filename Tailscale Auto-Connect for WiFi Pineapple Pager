boot() {
    # Start the tailscaled service via init script
    start

    # Wait for the daemon socket to become available (max 15 seconds)
    # This replaces the unreliable fixed sleep 3
    local socket="/var/run/tailscale/tailscaled.sock"
    local max_wait=15
    local waited=0

    LOG "Waiting for tailscaled socket..."
    while [ ! -S "$socket" ] && [ "$waited" -lt "$max_wait" ]; do
        sleep 1
        waited=$((waited + 1))
    done

    if [ ! -S "$socket" ]; then
        ERROR_DIALOG "tailscaled socket not found after ${max_wait}s. Check service status."
        return 1
    fi

    LOG "Socket ready after ${waited}s. Connecting..."

    # Bring the tailnet up. accept-dns=false is correct for the Pager
    # to avoid DNS conflicts with its own payload services
    if ! /usr/sbin/tailscale up --accept-dns=false; then
        # Check if already authenticated but just disconnected
        local status
        status=$(/usr/sbin/tailscale status 2>&1)
        
        if echo "$status" | grep -q "Logged out"; then
            ERROR_DIALOG "Tailscale is logged out. Run the configure payload first."
        elif echo "$status" | grep -q "Logged in"; then
            LOG "Already authenticated. Attempting reconnection..."
            /usr/sbin/tailscale up --accept-dns=false --reset
        else
            ERROR_DIALOG "Failed to bring up Tailscale. Status: $status"
        fi
        return 1
    fi

    LOG "Tailscale connected successfully."
}
