#!/bin/sh /etc/rc.common
# Independent worker, supervised by procd and optionally enabled at boot.
START=95
STOP=10
USE_PROCD=1
CONTROLLER=/root/payloads/user/general/Power-Aware-Display/controller.sh
start_service() {
    PAD_HOME="${CONTROLLER%/*}" /bin/bash "$CONTROLLER" ready || return 1
    procd_open_instance
    procd_set_param command /bin/bash "$CONTROLLER" daemon
    # Preserve the installed directory if an owner renamed the payload folder.
    procd_set_param env "PAD_HOME=${CONTROLLER%/*}"
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 8
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
