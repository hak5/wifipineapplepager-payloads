#!/bin/sh
# KEYSMITH DHCP hook.
#
# Configure the leased address on the tri-band interface only.  The Pager's
# management uplink owns the default route and /etc/resolv.conf, so this
# script deliberately installs neither: it records the gateway and DNS
# servers for the UI instead.

LEASE=/tmp/keysmith_lease

mask2prefix() {
    case "$1" in
        *.*)
            n=0
            for oct in $(echo "$1" | tr '.' ' '); do
                case "$oct" in
                    255) n=$((n + 8)) ;;
                    254) n=$((n + 7)) ;;
                    252) n=$((n + 6)) ;;
                    248) n=$((n + 5)) ;;
                    240) n=$((n + 4)) ;;
                    224) n=$((n + 3)) ;;
                    192) n=$((n + 2)) ;;
                    128) n=$((n + 1)) ;;
                esac
            done
            echo "$n"
            ;;
        *) echo "${1:-24}" ;;
    esac
}

case "$1" in
    deconfig)
        ip -4 addr flush dev "$interface" 2>/dev/null
        rm -f "$LEASE"
        ;;
    bound|renew)
        [ -n "$IP" ] || exit 0
        pfx=$(mask2prefix "${mask:-24}")
        ip -4 addr add "$IP/$pfx" dev "$interface" 2>/dev/null
        {
            echo "ip=$IP"
            echo "prefix=$pfx"
            echo "router=$router"
            echo "dns=$dns"
            echo "server=$server"
        } > "$LEASE"
        ;;
esac
exit 0
